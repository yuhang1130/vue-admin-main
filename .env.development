# 应用端口
VITE_APP_PORT=3000
# 项目名称
VITE_APP_TITLE=vue3-element-admin
# 代理前缀
VITE_APP_BASE_API=/dev-api

# 接口地址
# VITE_APP_API_URL=https://api.example.com       # 线上
# VITE_APP_API_URL=https://api.example.com/v2    # 线上(多租户)
VITE_APP_API_URL=http://localhost:8080       # 本地

# 多租户开关(true:开启 false:关闭)
VITE_APP_TENANT_ENABLED=false
